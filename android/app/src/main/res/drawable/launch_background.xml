<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <!-- Checkpoint M: the same launcher icon already installed at
         @mipmap/ic_launcher (KakeiboPlus), centered; no new asset,
         no delay, no animation, just what was already sitting
         commented-out here as the suggested pattern. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
