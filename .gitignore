# Flutter/Dart build output and tooling
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
*.ipr
*.iws

# Generated code — regenerated locally via build_runner, not committed.
